{
  "_comment": "Eight playlists. documentary.m3u is worldwide (countries: null) and uses match_mode 'or', so it takes every channel in the documentary or science category from any country, PLUS the named brands that iptv-org files under education/outdoor/no category (Da Vinci, Love Nature, Viasat Explore, Curiosity, Smithsonian). Discovery and Animal Planet patterns are kept so they appear automatically if a stream ever shows up. religious-pk.m3u uses name matching only, so it contains just the Madani channels.",
  "repo": "Inam321/tv",
  "options": {
    "exclude_geo_blocked": true,
    "exclude_bare_ip": false,
    "exclude_not_24_7": false,
    "max_streams_per_channel_before_verify": 3,
    "max_streams_per_channel_after_verify": 1,
    "always_keep": [
      "SkySportsCricket.ie",
      "SkySportsCricket.uk"
    ]
  },
  "playlists": [
    {
      "file": "news.m3u",
      "title": "India + Pakistan News",
      "countries": [
        "IN",
        "PK"
      ],
      "categories": [
        "news"
      ],
      "folder": "News",
      "colour": "#1D3B5C",
      "size": "big"
    },
    {
      "file": "sports.m3u",
      "title": "International Sports",
      "countries": null,
      "categories": [
        "sports"
      ],
      "folder": "Sports",
      "colour": "#1F5B3A",
      "size": "big"
    },
    {
      "file": "entertainment.m3u",
      "title": "India + Pakistan Entertainment",
      "countries": [
        "IN",
        "PK"
      ],
      "categories": [
        "entertainment",
        "series",
        "comedy",
        "family"
      ],
      "folder": "Entertainment",
      "colour": "#5C2A4A",
      "size": "medium"
    },
    {
      "file": "documentary.m3u",
      "title": "World Documentary & Knowledge",
      "countries": null,
      "categories": [
        "documentary",
        "science"
      ],
      "match": [
        "^national geograph",
        "nat[^a-z0-9]*geo",
        "^discovery",
        "^animal planet",
        "^history tv18",
        "^history( channel| hd| tv)?$",
        "^sony bbc earth",
        "^bbc earth",
        "^docubay",
        "^safari tv",
        "^love nature",
        "^curiosity",
        "^smithsonian",
        "^da vinci",
        "^viasat (nature|history|explore)"
      ],
      "match_mode": "or",
      "folder": "Documentary",
      "colour": "#14524A",
      "size": "medium"
    },
    {
      "file": "music.m3u",
      "title": "India + Pakistan Music",
      "countries": [
        "IN",
        "PK"
      ],
      "categories": [
        "music"
      ],
      "folder": "Music",
      "colour": "#6B3A12",
      "size": "medium"
    },
    {
      "file": "movies.m3u",
      "title": "India + Pakistan Movies",
      "countries": [
        "IN",
        "PK"
      ],
      "categories": [
        "movies"
      ],
      "folder": "Movies",
      "colour": "#3A2B5C",
      "size": "medium"
    },
    {
      "file": "kids.m3u",
      "title": "India + Pakistan Kids",
      "countries": [
        "IN",
        "PK"
      ],
      "categories": [
        "kids",
        "animation"
      ],
      "folder": "Kids",
      "colour": "#7A4A0F",
      "size": "small"
    },
    {
      "file": "religious-pk.m3u",
      "title": "Madani Channels",
      "countries": null,
      "categories": null,
      "match": [
        "^Madani Channel Urdu$",
        "^Madani Channel English$",
        "^Madani Channel$",
        "ary[^a-z0-9]*q[^a-z0-9]*tv"
      ],
      "folder": "Madani",
      "colour": "#2A4A4A",
      "size": "small"
    }
  ]
}
